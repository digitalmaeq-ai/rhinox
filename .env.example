# WooCommerce connection (copy to .env.local and fill in; .env.local is never committed).
# Create the key in WordPress: WooCommerce > Settings > Advanced > REST API > Add key,
# permissions = Read (the site only needs to read products).
WOOCOMMERCE_URL=https://shop.example.com
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public address of the site, used for the sitemap and robots.txt.
# Optional on Vercel (its own address is used until you set this). Set it once the real domain is live.
NEXT_PUBLIC_SITE_URL=https://www.example.com
